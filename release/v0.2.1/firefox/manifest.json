{
    "manifest_version":  3,
    "name":  "AI Prompt Enhancer",
    "version":  "0.2.1",
    "description":  "Context-aware prompt optimization for AI chat interfaces",
    "permissions":  [
                        "storage",
                        "activeTab",
                        "scripting"
                    ],
    "host_permissions":  [
                             "https://chat.openai.com/*",
                             "https://chatgpt.com/*",
                             "https://claude.ai/*",
                             "https://gemini.google.com/*",
                             "https://generativelanguage.googleapis.com/*",
                             "https://api.groq.com/*",
                             "https://www.perplexity.ai/*",
                             "https://aistudio.google.com/*"
                         ],
    "background":  {
                       "service_worker":  "dist/service-worker.js",
                       "scripts":  [
                                       "dist/service-worker.js"
                                   ]
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "dist/content.js"
                                       ],
                                "css":  [
                                            "assets/styles/inline-ui.css"
                                        ],
                                "run_at":  "document_idle",
                                "all_frames":  false
                            }
                        ],
    "action":  {
                   "default_popup":  "src/popup/popup.html",
                   "default_icon":  {
                                        "16":  "assets/icons/icon-16-zoomed.png",
                                        "32":  "assets/icons/icon-32-zoomed.png",
                                        "48":  "assets/icons/icon-48-zoomed.png",
                                        "128":  "assets/icons/icon-128.png"
                                    }
               },
    "options_page":  "src/options/options.html",
    "icons":  {
                  "16":  "assets/icons/icon-16.png",
                  "48":  "assets/icons/icon-48.png",
                  "128":  "assets/icons/icon-128.png"
              },
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "assets/*"
                                                       ],
                                         "matches":  [
                                                         "\u003call_urls\u003e"
                                                     ]
                                     }
                                 ],
    "browser_specific_settings":  {
                                      "gecko":  {
                                                    "id":  "prompt-enhancer@likheet",
                                                    "strict_min_version":  "109.0"
                                                }
                                  }
}
